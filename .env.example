# MongoDB connection string used by lib/db/connect.ts.
# Local: mongodb://127.0.0.1:27017/linkbase
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/linkbase?retryWrites=true&w=majority
MONGODB_URI=

# Secret used by NextAuth to sign/encrypt session JWTs and CSRF tokens.
# Generate one with: npx auth secret   (writes to .env.local)
AUTH_SECRET=
